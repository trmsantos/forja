# Copy to .env and fill in as needed.
FRONTEND_ORIGIN=http://localhost:4000

# Secret used to sign login + verification tokens. Set a long random string in production.
JWT_SECRET=dev-secret-change-in-production

# Encrypts customer Stripe keys at rest. Keep DIFFERENT from JWT_SECRET. Any string works.
# WARNING: change this and existing stored keys can no longer be decrypted.
ENCRYPTION_KEY=dev-secret-change-in-production

# --- Email ---------------------------------------------------------------
# Pick ONE transport. With neither configured, emails print to the server console.
STUDIO_EMAIL=hello@forja.studio
EMAIL_FROM=Forja <hello@forja.studio>
# Branded sender domain (recommended). Reminders land in inboxes far more reliably when they
# come from YOUR verified domain rather than a generic address:
#   Resend: add + verify your domain at resend.com/domains (it gives you SPF/DKIM DNS records
#           to add at your registrar), then set EMAIL_FROM to that domain, e.g.
#             EMAIL_FROM="Acme Studio <billing@acme.studio>"
#   SMTP:   use a mailbox on your own domain with SPF/DKIM configured.
# Reminders set Reply-To to the vendor's address, so client replies go to them, not Forja.
# (Per-customer branded sender domains are the planned Agency-tier feature.)

# Option A — Resend (simplest; free tier at resend.com, verify a domain first)
RESEND_API_KEY=

# Option B — SMTP (Gmail, your domain, Mailgun, etc.). Used only if RESEND_API_KEY is empty.
#   Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
#   SMTP_PASSWORD=<a Google "App Password", not your normal password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Stripe (optional) ---------------------------------------------------
# Pay-by-link model: you send clients a Stripe Payment Link or invoice; the webhook
# below records the paid order, emails a receipt, and shows it in their account.
STRIPE_SECRET_KEY=
# From `stripe listen` (dev) or the Dashboard webhook (prod). If empty, the webhook
# accepts unverified events (dev only) so you can test with the Stripe CLI.
STRIPE_WEBHOOK_SECRET=
# Only needed if you later re-enable on-site Checkout for fixed packages.
STRIPE_PRICE_AUDIT=
STRIPE_PRICE_AUTOMATION=

# --- Collections Agent (the autonomous reminder engine) ------------------
# OFF by default so a fresh boot never emails real debtors. Set to 1 to run the daily sweep.
COLLECTIONS_ENABLED=0
# Dry-run (log instead of send) is the default safety net. Set to 0 to actually email debtors.
COLLECTIONS_DRY_RUN=1
# Hour (UTC) of the daily sweep, and the escalation rules.
COLLECTIONS_HOUR=9
COLLECTIONS_MAX_STEPS=3
COLLECTIONS_MIN_GAP_DAYS=7
